        <mxCell id="c35" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#C0392B;spacing=0;" value="Recepción rechaza&lt;br&gt;(correo con el motivo)" vertex="1">
